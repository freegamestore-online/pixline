{
  "name": "pixline",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "description": "Free daily nonogram: reveal a hidden picture from its row and column clues.",
  "engines": { "node": ">=22" },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] },
  "scripts": {
    "dev": "pnpm --filter @pixline/web dev",
    "build": "pnpm --filter @pixline/web build",
    "preview": "pnpm --filter @pixline/web preview",
    "typecheck": "pnpm --filter @pixline/web exec tsc -b",
    "test": "pnpm --filter @pixline/web test"
  }
}
